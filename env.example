# ---- Telegram ----
# Токен бота, полученный у @BotFather
TG_TOKEN=1234567890:AAEhBOweik6ad9r_QXMENQjcrGbqCr4K-5s

# Прокси для доступа к api.telegram.org (если прямой доступ закрыт).
# Форматы:
#   http://1.2.3.4:8080
#   http://user:pass@1.2.3.4:8080
#   socks5://1.2.3.4:1080
#   socks5://user:pass@1.2.3.4:1080   (socks5h:// тоже понимается)
# Пусто — прямое соединение. MTProto-прокси (tg://...) НЕ подходят!
TG_PROXY_URL=socks5://user:pass@1.2.3.4:1080

# Telegram user_id, которым разрешено пользоваться ботом (через запятую).
# Свой id можно узнать у @userinfobot
ALLOWED_USERS=123456789,987654321

# ---- Zabbix 6.0 ----
# URL фронтенда Zabbix БЕЗ /api_jsonrpc.php
ZABBIX_URL=http://zabbix.example.com
# Какой адрес подставлять в кнопки «открыть в Zabbix» (если пусто — берётся ZABBIX_URL).
# Укажите, если с телефона фронтенд доступен по другому адресу/имени.
# ZABBIX_WEB_URL=http://zabbix.corp.local
ZABBIX_USER=telegram-bot
ZABBIX_PASSWORD=СуперСекретныйПароль

# Проверять SSL-сертификат Zabbix (для самоподписанного — false)
ZABBIX_VERIFY_SSL=true

# ---- Интерфейс ----
# Узлов на страницу в списках
HOSTS_PER_PAGE=8

# ---- Уведомления о новых проблемах ----
# Рассылать новые проблемы всем пользователям из ALLOWED_USERS
NOTIFY_ENABLED=true
# Минимальная важность: 0-не класиф., 1-инфо, 2-предупреждение, 3-средняя, 4-высокая, 5-критическая
NOTIFY_MIN_SEVERITY=3
# Как часто опрашивать Zabbix, секунд (минимум 20)
NOTIFY_POLL_SECONDS=60
